{
  "name": "btmusicdrive",
  "version": "1.0.0",
  "description": "",
  "main": "checkout.js",
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.min.css --minify",
    "watch:css": "tailwindcss -i ./tailwind.input.css -o ./tailwind.min.css --watch",
    "postinstall": "npm --prefix server ci",
    "combine:css": "node scripts/combine-css.js",
    "hash:assets": "node scripts/hash-assets.js",
    "inline:products": "node scripts/inline-products.js",
    "inline:categories": "node scripts/inline-categories.js",
    "inline:product-jsonld": "node scripts/inline-product-jsonld.js",
    "build:sitemap": "node scripts/generate-sitemap.js",
    "mkt:build": "node scripts/build-marketplace-images.js --apply",
    "mkt:upload": "node scripts/upload-r2.js --apply",
    "mkt:inspect": "node scripts/inspect-shopee-template.js",
    "mkt:desc": "node scripts/generate-shopee-descriptions.js --apply --force",
    "mkt:shopee": "node scripts/fill-shopee-template.js --apply",
    "mkt:listings": "node scripts/generate-marketplace-listings.js --apply",
    "mkt:tiktok": "node scripts/fill-tiktok-template.js --apply",
    "mkt:studio": "node scripts/listing-studio.js",
    "mkt:originals": "node scripts/backfill-originals.js",
    "mkt:qr-all": "node scripts/generate-tracklist-qrs.js --apply",
    "seo:artists": "node scripts/artists-cli.js todo",
    "seo:artists:prompt": "node scripts/artists-cli.js prompt",
    "seo:artists:save": "node scripts/artists-cli.js save",
    "seo:artists:stats": "node scripts/artists-cli.js stats",
    "seo:artists:test": "node scripts/artists-cli.js selftest",
    "perf:baseline": "bash scripts/run-lighthouse-baseline.sh",
    "perf:summary": "node scripts/summarize-lighthouse.js reports/pagespeed",
    "seo:descriptions": "node scripts/improve-product-descriptions.js",
    "seo:descriptions:apply": "node scripts/improve-product-descriptions.js --apply",
    "images:optimize-product": "node scripts/optimize-product-images.js",
    "images:r2-web": "node scripts/migrate-web-images-to-r2.js --apply",
    "build": "npm run build:css && npm run combine:css && npm run inline:products && npm run inline:categories && npm run inline:product-jsonld && npm run build:sitemap && npm run hash:assets",
    "test": "node scripts/test-seo.js && node scripts/test-studio-agent-seo.js && node scripts/test-studio-ui.js && node scripts/test-studio-nas-images.js && node scripts/test-nas-image-watcher.js && node scripts/test-r2-web-images.js && node scripts/test-vercel-server-install.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manachat72/btmusicdrive.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/manachat72/btmusicdrive/issues"
  },
  "homepage": "https://github.com/manachat72/btmusicdrive#readme",
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "xlsx": "^0.18.5"
  }
}
