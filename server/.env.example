# ====== Database ======
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require&channel_binding=require"

# ====== JWT Secret ======
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-secret-key-min-32-characters-long"

# ====== Stripe Payment Gateway ======
STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxx"

# ====== Google OAuth ======
# Same client ID as hardcoded in components.js (GOOGLE_CLIENT_ID constant)
# Only the Client ID is needed for ID-token verification — the secret is not used.
GOOGLE_CLIENT_ID="46644504211-02mjffk321u1h5hbh1r5e5j5in30od93.apps.googleusercontent.com"

# ====== Google Analytics 4 Reporting ======
# Numeric GA4 Property ID (not Measurement ID / G-XXXX)
GA4_PROPERTY_ID="533617757"
# Pick one credential option. Do not commit real service account credentials.
# GOOGLE_APPLICATION_CREDENTIALS="C:/Users/you/Secrets/ga-service-account.json"
# GA_SERVICE_ACCOUNT_PATH="C:/Users/you/Secrets/ga-service-account.json"
# GA_SERVICE_ACCOUNT_JSON="{\"type\":\"service_account\",...}"
# GA_SERVICE_ACCOUNT_BASE64="base64-encoded-service-account-json"

# ====== Email (SMTP) ======
# Gmail: Use App Password (not regular password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# ====== URLs ======
# Frontend deployment URL
FRONTEND_URL="https://yourdomain.vercel.app"
CLIENT_URL="http://127.0.0.1:5500"

# ====== Server ======
PORT="5000"
NODE_ENV="development"

# ====== CORS ======
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:5500,http://127.0.0.1:5500"

# ====== Admin ======
# Fallback password for admin dashboard (x-admin-password header)
ADMIN_PASSWORD="btmusicdrive-admin-2025"

# ====== LINE Messaging API (Chat Bot) ======
# From LINE Developers Console → your Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN="your-line-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"

# ====== AI auto-reply for LINE bot ======
# Used in production (Vercel). From platform.openai.com → API Keys
OPENAI_KEY="sk-xxxxxxxxxxxxxxxxx"
# Optional — defaults to gpt-4o-mini (fast + cheap, good for chat replies)
OPENAI_MODEL="gpt-4o-mini"

# Optional local Llama via Ollama (dev only). If OLLAMA_URL is set, the bot
# uses it instead of OpenAI. Vercel CANNOT reach your localhost, so leave this
# unset in production. Typhoon 2 is a Thai-tuned Llama 3.1 8B model.
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="scb10x/llama3.1-typhoon2-8b-instruct"
